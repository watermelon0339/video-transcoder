TZ=UTC
PORT=3333
HOST=localhost
LOG_LEVEL=info
APP_KEY=uJmed2ufpgDWQQN5iEwl3A==
NODE_ENV=production

# TRANSCODER OPTIONS

# location of default files to process if source is omitted in command
SOURCE_LOCATION=/home/ubuntu/video_input

# location to place processed files
OUTPUT_LOCATION=/home/ubuntu/video_output

# GPU mode for ffmpeg video pipelines (transcode + compression only)
# auto strategy:
# - macOS: videotoolbox -> cpu fallback
# - Linux/WSL: nvidia (nvenc) -> amd (vaapi) -> cpu fallback
GPU=auto # options: auto | cpu | nvidia | amd | apple-m | apple-intel

FORCE_CPU_DEVICE=false # if true, forces CPU usage for faster-whisper

# python location or faster-whisper isolate phython location; `pip install faster-whisper`
# if python is in your path, just 'python' will suffice
PYTHON_FASTER_WHISPER=python

# split name by `-` and suffix with a cuid to uniquely name
USE_UNIQUE_NAME=false

# include compress MP4 (resolution will be highest from provided resolutions)
INCLUDE_MP4=false

# include animated WEBP image
INCLUDE_WEBP=true

# include transcription in output
INCLUDE_TRANSCRIPTION=true

# translation target language codes (comma-separated); leave empty to skip translations
TRANSCRIPTION_LANGS= # e.g. es,fr,de,pl,pt,pb

# resolutions to transcode to, if resolution of source video is less than provided resolution, it will be skipped
# RESOLUTIONS=2160,1440,1080,720,480,360
# RESOLUTIONS=1080,720,480,360
RESOLUTIONS=720,480
