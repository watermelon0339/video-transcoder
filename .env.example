TZ=UTC
PORT=3333
HOST=localhost
LOG_LEVEL=info
APP_KEY=APP_KEY=uJmed2ufpgDWQQN5iEwl3A==
NODE_ENV=production

# TRANSCODER OPTIONS

# location of default files to process if source is omitted in command
SOURCE_LOCATION=/home/ubuntu/video_input

# location to place processed files
OUTPUT_LOCATION=/home/ubuntu/video_output

# python location or faster-whisper isolate phython location; `pip install faster-whisper`
# if python is in your path, just 'python' will suffice
PYTHON_FASTER_WHISPER=python

# split name by `-` and suffix with a cuid to uniquely name
USE_UNIQUE_NAME=false

# include compress MP4 (resolution will be highest from provided resolutions)
INCLUDE_MP4=true

# include animated WEBP image
INCLUDE_WEBP=true

# include transcription in output
INCLUDE_TRANSCRIPTION=false

# languages to transcribe to (en will automatically be included)
TRANSCRIPTION_LANGS=es,fr,de,pl,pt,pb # english, french, polish, portuguese, portuguese-brazil

# resolutions to transcode to
# RESOLUTIONS=2160,1440,1080,720,480,360
RESOLUTIONS=1080,720,480,360
